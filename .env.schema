# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @defaultRequired=true @defaultSensitive=false
# @import(./.env.dev.schema, enabled=eq($APP_MODE, "dev"))
# ----------

# The application app mode
# @type=enum(dev, prod, ci)
APP_MODE=dev

# @type=enum(debug, info, warn, error)
LOG_LEVEL=ifs(
    eq($APP_MODE, prod), info,
    debug
)

## Ports

# The port of the fastapi backend app
# @type=port
PORT=8000

# @type=port
LLM_API_PORT=8001

# @type=port
CLIENT_PORT=3000

# @type=port
WHISPER_PORT=50001

# @type=port
DOCLING_PORT=8004

## Urls

# The URL for client application
# @type=url
CLIENT_URL=if(
    eq($APP_MODE, dev), http://localhost:${CLIENT_PORT}, )


# The URL for LLM API
# @type=url
LLM_URL=if(
    eq($APP_MODE, dev), "http://localhost:${LLM_API_PORT}/v1", )


# The url for the Whisper api
# @type=url
WHISPER_URL=if(
    eq($APP_MODE, dev), "http://localhost:${WHISPER_PORT}/v1", )

# The url for the Docling api
# @type=url
DOCLING_URL=if(
    eq($APP_MODE, dev), "http://localhost:${DOCLING_PORT}/v1", )

# The api key for docling
# @type=string @sensitive=eq($APP_MODE, prod)
DOCLING_API_KEY=ifs(
    eq($APP_MODE, prod), "",
    "none"
)

# The URL for LLM health check API
# @type=url
LLM_HEALTH_CHECK_URL=if(
    eq($APP_MODE, dev), "http://localhost:${LLM_API_PORT}/health", )

## LLM

# The model for LLM API
# @type=string
LLM_MODEL=ifs(
    eq($APP_MODE, prod), "",
    "Gemma/Gemma-4-31B"
)

# The API key for authenticating with OpenAI
# @sensitive=eq($APP_MODE, prod)
LLM_API_KEY=ifs(
    eq($APP_MODE, prod), "",
    "none"
)

# Enable LLM reasoning
# @type=boolean
LLM_REASONING=false

## Secrets

# Used to pseudonymize user id. Create with openssl rand 32 | base64
# @sensitive
HMAC_SECRET=

## Flags

# Flag to indicate if the APP_MODE is production used for the logger
# @type=boolean
IS_PROD=eq($APP_MODE, prod)

# For docker compose
# ---

## Hugging Face

# only needed for docker containers
# @optional @sensitive
HUGGING_FACE_HUB_TOKEN=

## Caching dirs for docker
CACHE_DIR="~/.cache"
HUGGING_FACE_CACHE_DIR=${CACHE_DIR}/huggingface
